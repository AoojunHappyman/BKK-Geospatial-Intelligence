# Use a URL-safe random local password. Do not commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
# For a separately managed local PostgreSQL/PostGIS server:
# DATABASE_URL=postgresql://bkk:YOUR_PASSWORD@127.0.0.1:5432/bkk

API_DATABASE_PASSWORD=replace-with-a-different-url-safe-password

# Required only with docker-compose.https.yml: hostname without scheme or path.
# SITE_DOMAIN=geo.your-domain.com
